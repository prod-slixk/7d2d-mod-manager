{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "7D2D Mod Manager",
  "mainBinaryName": "7D2D-Mod-Manager",
  "version": "1.3.2",
  "identifier": "local.sevendays.modmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "7D2D Mod Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://staticdelivery.nexusmods.com; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
